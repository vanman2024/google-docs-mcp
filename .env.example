# Google Docs MCP Server - Environment Variables
#
# For Horizon/Prefect Cloud deployment, set GOOGLE_DOCS_TOKEN_JSON
# with the full OAuth token JSON from your local ~/.config/mcp-gdrive/docs-token.json
#
# Example: GOOGLE_DOCS_TOKEN_JSON={"token": "ya29...", "refresh_token": "1//...", "client_id": "...", "client_secret": "..."}
GOOGLE_DOCS_TOKEN_JSON=
