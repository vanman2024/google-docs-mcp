{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "src/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "python": ">=3.10",
    "project": "."
  },
  "deployment": {
    "transport": "http",
    "host": "0.0.0.0",
    "port": 3000,
    "log_level": "INFO",
    "env": {
      "GOOGLE_DOCS_TOKEN_JSON": "${GOOGLE_DOCS_TOKEN_JSON}"
    }
  }
}
